# Livbee Backend — 환경변수 예시
# 복사 후 .env 로 저장하고 값을 채운 뒤 사용. .env 는 Git 에 커밋하지 마세요.

# ---------- 필수 (앱 기동에 필요) ----------
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
JWT_SECRET=

# ---------- JWT (선택) ----------
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
# JWT_EXPIRES_IN=7d

# ---------- Cloudinary (이미지 업로드, 선택) ----------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=
# CLOUDINARY_THUMB=c_fill,g_auto,w_640,h_360,f_auto,q_auto

# ---------- Redis (SMS 인증 등, 선택) ----------
# REDIS_URL=
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_DB=0

# ---------- Solapi SMS (선택) ----------
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER_NUMBER=
# SMS_SKIP_SEND=false

# ---------- 국세청 사업자 API (선택) ----------
# NTS_BUSINESS_API_BASE_URL=
# NTS_BUSINESS_API_KEY=
# NTS_BUSINESS_API_TIMEOUT_SECONDS=5

# ---------- API · 환경 ----------
# API_BASE_PATH=/api/v1
# JSON_LIMIT=1mb
# ENVIRONMENT=development
# NODE_ENV=development
# TESTING=false

# ---------- CORS ----------
# CORS_ORIGINS=http://localhost:5173,https://dev.livbee.co.kr
